# Placeholders only - never commit real values.
# Local dev / Render: set these as environment variables.

# Free Postgres from Neon (neon.tech) - use the DIRECT (non-pooled) connection string
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# From the Clerk dashboard (dashboard.clerk.com) -> API Keys (development instance is fine)
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
# Same value as CLERK_PUBLISHABLE_KEY; read at BUILD time by Vite
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
